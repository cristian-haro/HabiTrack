# ==============================================================================
# HABITRACK - CONFIGURACIÓN DE VARIABLES DE ENTORNO / ENVIRONMENT VARIABLES
# ==============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# JSON Web Token Secret
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=30d

# Database Configuration (Optional: SQLite casas.db used by default if empty)
# PostgreSQL / Supabase / Neon connection string:
# DATABASE_URL=postgres://user:password@localhost:5432/habitrack

# SMTP Email Configuration for OTP access codes (Optional: Dev OTP shown in UI if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="HabiTrack" <no-reply@habitrack.app>