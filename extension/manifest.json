{
  "manifest_version": 3,
  "name": "HabiTrack - Capturador Inmobiliario",
  "description": "Guarda y analiza inmuebles en 1 clic desde Idealista, Fotocasa, Habitaclia, YaEncontre, Pisos.com y más directamente en tu HabiTrack.",
  "version": "1.0.1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HabiTrack Inmobiliario",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.idealista.com/*",
    "*://idealista.com/*",
    "*://*.fotocasa.es/*",
    "*://fotocasa.es/*",
    "*://*.habitaclia.com/*",
    "*://habitaclia.com/*",
    "*://*.yaencontre.com/*",
    "*://yaencontre.com/*",
    "*://*.pisos.com/*",
    "*://pisos.com/*",
    "*://*.facebook.com/marketplace/*",
    "*://facebook.com/marketplace/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.idealista.com/*",
        "*://idealista.com/*",
        "*://*.fotocasa.es/*",
        "*://fotocasa.es/*",
        "*://*.habitaclia.com/*",
        "*://habitaclia.com/*",
        "*://*.yaencontre.com/*",
        "*://yaencontre.com/*",
        "*://*.pisos.com/*",
        "*://pisos.com/*",
        "*://*.facebook.com/marketplace/*",
        "*://facebook.com/marketplace/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
